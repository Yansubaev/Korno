<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Версия Play Services в заголовке лога: без запроса пакет с Android 11 не виден. -->
    <queries>
        <package android:name="com.google.android.gms" />
    </queries>

    <application>
        <provider
            android:name="com.ians.korno.core.logging.DiagnosticsFileProvider"
            android:authorities="${applicationId}.diagnostics"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/debug_log_paths" />
        </provider>
    </application>
</manifest>
